extends SceneTree

const NAV := preload("res://scripts/flight_navigation.gd")
const GEOMETRY := preload("res://scripts/projectile_geometry.gd")
const ASTEROID := preload("res://scripts/asteroid_factory.gd")
const ROCKET := preload("res://scripts/rocket_projectile.gd")
const DAMAGE := preload("res://scripts/combat_damage.gd")

func _initialize() -> void:
	assert(NAV.navigation_velocity(Vector2.ZERO, Vector2.LEFT, Vector2.RIGHT, 100.0, 20.0, 0.1) == Vector2.ZERO)
	assert(NAV.navigation_velocity(Vector2.ZERO, Vector2.RIGHT, Vector2.RIGHT, 100.0, 20.0, 0.1).is_equal_approx(Vector2(2, 0)))
	assert(NAV.steered_rotation(0.0, 0.0, Vector2.RIGHT, 1.0, 0.1).is_equal_approx(Vector2.ZERO))
	var step := NAV.move_order_step(Vector2.ZERO, 0.0, Vector2.ZERO, Vector2(100, 0), 100.0, 20.0, 1.0, 0.9, 0.1)
	assert(not step.arrived and step.velocity.is_equal_approx(Vector2(2, 0)) and step.engine_target > 0.99)
	step = NAV.move_order_step(Vector2.ZERO, 0.0, Vector2.RIGHT, Vector2(4, 0), 100.0, 20.0, 1.0, 0.9, 0.1)
	assert(step.arrived and step.velocity == Vector2.ZERO)
	step = NAV.move_order_step(Vector2.ZERO, PI, Vector2.LEFT * 10, Vector2(100, 0), 100.0, 20.0, 1.0, 0.9, 0.1)
	assert(not step.arrived and step.velocity.length() < 10.0 and step.engine_target == 0.0)
	var damage := DAMAGE.apply(5.0, 100.0, 12.0)
	assert(damage.absorbed == 5.0 and damage.shield == 0.0 and damage.hull == 93.0)
	damage = DAMAGE.apply(10.0, 100.0, 2.0)
	assert(damage.shield == 8.0 and damage.hull == 100.0)
	var hit: Variant = GEOMETRY.segment_ellipse_hit(Vector2(-3, 0), Vector2(3, 0), Vector2.ZERO, -PI / 2, Vector2(2, 1))
	assert(hit != null and (hit as Vector2).is_equal_approx(Vector2(-2, 0)))
	assert(GEOMETRY.segment_ellipse_hit(Vector2(-3, 2), Vector2(3, 2), Vector2.ZERO, -PI / 2, Vector2(2, 1)) == null)
	var square := PackedVector2Array([Vector2(-1, -1), Vector2(1, -1), Vector2(1, 1), Vector2(-1, 1)])
	hit = GEOMETRY.segment_polygon_hit(Vector2(-2, 0), Vector2(2, 0), square)
	assert(hit != null and (hit as Vector2).is_equal_approx(Vector2(-1, 0)))
	assert(GEOMETRY.segment_polygon_hit(Vector2.ZERO, Vector2(2, 0), square) == Vector2.ZERO)
	hit = GEOMETRY.ship_hull_hit(Vector2(-2, 0), Vector2(4, 0), Vector2(1, 0), -PI / 2, [square])
	assert(hit != null and (hit as Vector2).is_equal_approx(Vector2.ZERO))
	hit = GEOMETRY.ship_cells_hit(Vector2(-2, 0), Vector2(2, 0), Vector2.ZERO, -PI / 2, [{"offset": Vector2.ZERO}], 2.0)
	assert(hit != null and (hit as Vector2).is_equal_approx(Vector2(-1, 0)))
	var rocks := [{"position": Vector2(1, 0), "radius": 2.0, "iron": 1, "shape": square}, {"position": Vector2(-2, 0), "radius": 2.0, "iron": 0, "shape": square}]
	hit = GEOMETRY.asteroid_hit(Vector2(-4, 0), Vector2(4, 0), rocks)
	assert(hit != null and (hit as Vector2).is_equal_approx(Vector2.ZERO))
	var rock := ASTEROID.create(Vector2.ZERO, 20.0, 1.0, "0/0", 123, {})
	var same := ASTEROID.create(Vector2.ZERO, 20.0, 1.0, "0/0", 123, {"0/0": 2})
	assert(rock.shape == same.shape and rock.base == same.base and same.iron == 2)
	for point in rock.shape:
		assert(point.length() <= 20.0)
	var missile := ROCKET.create(Vector2.ZERO, 0.0, Vector2.ZERO, false, 10.0)
	ROCKET.update(missile, Vector2(0, 1000), 0.1)
	assert(is_zero_approx(missile.rocket_heading))
	ROCKET.update(missile, Vector2(0, 1000), 0.1)
	assert(missile.rocket_heading > 0.0 and missile.rocket_speed > ROCKET.EJECTION_SPEED)
	print("Game system checks passed")
	quit()
